#!/usr/bin/env python

"""PGSync runtime."""
# Initialize Datadog tracer before pgsync imports that create connections.
try:
    import ddtrace.auto  # install instrumentation as early as possible
    from ddtrace import patch
    # Make sure we patch elasticsearch to use the Datadog tracer
    patch(elasticsearch=True)
except ImportError:
    pass

from pgsync import sync

if __name__ == "__main__":
    sync.main()
